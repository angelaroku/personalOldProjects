<UserControl x:Class="App1SocialLink.Components.OtraCosaMas"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:App1SocialLink.Components"
             Width="270" Height="120">

    <Border x:Name="TagBorder2"
            Background="MediumVioletRed"
            CornerRadius="6"
            Padding="8,3"
            VerticalAlignment="Top">

        <StackPanel Orientation="Horizontal" Spacing="30" HorizontalAlignment="Center">

            <SymbolIcon x:Name="TagIcon1" Symbol="Favorite"/>
            <SymbolIcon x:Name="TagIcon2" Symbol="Favorite"/>
            <SymbolIcon x:Name="TagIcon3" Symbol="Favorite"/>
            <SymbolIcon x:Name="TagIcon4" Symbol="Favorite"/>
            <SymbolIcon x:Name="TagIcon5" Symbol="Favorite"/>

        </StackPanel>
    </Border>
</UserControl>