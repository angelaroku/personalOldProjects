<!--CLASE REUTILIZABLE - ESTRUCTURA: cambiar etiqueta "Page" por "User Control"-->
    
    <UserControl
    x:Class="App1SocialLink.Components.Cosa1"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:App1SocialLink.Components"
    xmlns:local2="using:App1SocialLink.Components"
    Width="300" Height="300">
    <Border CornerRadius="8" BorderBrush="Azure"  BorderThickness="2" Padding="10" Background="Beige">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="55"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="60"/>
            </Grid.RowDefinitions>


            <Grid Grid.Row="0" Margin="0,2,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <!--Llamo a componente y cambio a mi gusto las variables del cs, no las del xaml originales-->
                <local:NuevaCosa x:Name="TagControl" csTextoDeMiNuevaCosa="Nombre_Usuario" csBackgroundColor ="LightSeaGreen" csNuevoIconoNuevaCosa="Account" />

            </Grid>

            <!-- defino el contenido de mi componente reutilizable-->
            <StackPanel  Grid.Row="1"  Margin="0,5,0,0" >

                <TextBlock x:Name="Temática_publicacion" Text="Temática" FontSize="16" FontWeight="SemiBold" Foreground="Black"/>
                <TextBlock x:Name="Descripcion" Text="Descripción breve" FontSize="12" Foreground="Gray"/>


                <StackPanel x:Name="InfoPanel" Orientation="Vertical" Margin="0,5,0,0">

                    <Rectangle Fill="LightGray" Width="270" Height="90" RadiusX="8" RadiusY="8" />
                    <Button Content="Ver" VerticalAlignment="Bottom" Foreground="Black" Width="90" Margin="0,5,0,0" />
                </StackPanel>
            </StackPanel>

            <Grid Grid.Row="2"  Margin="0,9,0,0">
                <local2:OtraCosaMas x:Name="TagControl2" />
            </Grid>
        </Grid>
    </Border>
</UserControl> 